# ---- 项目标识 ----
COMPOSE_PROJECT_NAME=podcastdig

# ---- 端口（题目分配，不可改）----
FRONTEND_PORT=18252
BACKEND_PORT=19252
DB_PORT=17752

# ---- 数据库 ----
DB_NAME=podcastdig
DB_USER=podcastdig
DB_PASSWORD=podcastdig_pw_2026
DB_ROOT_PASSWORD=podcastdig_root_2026

# ---- 安全 ----
JWT_SECRET=podcastdig-jwt-secret-change-me-2026

# ---- 运行时 ----
REDIS_URL=redis://redis:6379/0
SEED_DEMO=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=120
